@using VsExample.Domain.Entities.Questionaire
@model VSExample.Web.ViewModels.Questionnaires.QuestionnaireDetailsViewModel

<div class="container">
    <h1>@Model.Questionnaire.Title</h1>

    <form asp-action="SubmitQuestionnaire" method="post" class="needs-validation" novalidate>
        @foreach (var group in Model.Questionnaire.QuestionGroups.OrderBy(g => g.Order))
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">@group.Name</h5>
                    <small class="text-muted">@group.Description</small>
                </div>
                <div class="card-body">
                    @foreach (var question in group.Questions.OrderBy(q => q.Order))
                    {
                        <div class="form-group mb-3">
                            <label for="question-@question.Id" class="form-label">@question.Text</label>

                            @switch (question.AnswerType)
                            {
                                case AnswerTypeEnum.String:
                                    <input type="text"
                                           class="form-control @(question.IsRequired ? "is-invalid" : "")"
                                           id="question-@question.Id"
                                           name="Answers[@question.Id]"
                                           required="@question.IsRequired"
                                           oninput="removeInvalidClass(this)" />
                                    <div class="invalid-feedback">
                                        This question is required.
                                    </div>
                                    break;

                                case AnswerTypeEnum.Integer:
                                    <input type="number"
                                           class="form-control @(question.IsRequired ? "is-invalid" : "")"
                                           id="question-@question.Id"
                                           name="Answers[@question.Id]"
                                           required="@question.IsRequired"
                                           oninput="removeInvalidClass(this)" />
                                    <div class="invalid-feedback">
                                        This question is required.
                                    </div>
                                    break;

                                case AnswerTypeEnum.Decimal:
                                    <input type="number"
                                           step="0.01"
                                           class="form-control @(question.IsRequired ? "is-invalid" : "")"
                                           id="question-@question.Id"
                                           name="Answers[@question.Id]"
                                           required="@question.IsRequired"
                                           oninput="removeInvalidClass(this)" />
                                    <div class="invalid-feedback">
                                        This question is required.
                                    </div>
                                    break;

                                case AnswerTypeEnum.DateTime:
                                    <input type="date"
                                           class="form-control @(question.IsRequired ? "is-invalid" : "")"
                                           id="question-@question.Id"
                                           name="Answers[@question.Id]"
                                           required="@question.IsRequired"
                                           oninput="removeInvalidClass(this)" />
                                    <div class="invalid-feedback">
                                        This question is required.
                                    </div>
                                    break;

                                case AnswerTypeEnum.Boolean:
                                    <div class="form-check">
                                        <input type="checkbox"
                                               class="form-check-input"
                                               id="question-@question.Id"
                                               name="Answers[@question.Id]"
                                               value="true"
                                               onchange="removeInvalidClass(this)" />
                                        <label class="form-check-label" for="question-@question.Id">
                                            Yes
                                        </label>
                                    </div>
                                    break;

                                case AnswerTypeEnum.MultiValue:
                                    
                                        @foreach (var option in question.Options.OrderBy(o => o.Id))
                                        {
                                            <div class="form-check">
                                            <input type="checkbox"
                                                   class="form-check-input"
                                                   id="question-option-@option.Id"
                                                   name="Answers[@question.Id]"
                                                   value="@option.Id"
                                                   onchange="removeInvalidClass(this)" />
                                            <label class="form-check-label" for="question-option-@option.Id">
                                                @option.Text
                                            </label>
                                            </div>
                                        }
                                    
                                    <div class="invalid-feedback">
                                        You must select at least one option.
                                    </div>
                                    break;

                                case AnswerTypeEnum.SingleValue:
                                    @foreach (var option in question.Options.OrderBy(o => o.Id))
                                    {
                                        <div class="form-check">
                                            <input type="radio"
                                                   class="form-check-input"
                                                   id="question-@question.Id-option-@option.Id"
                                                   name="Answers[@question.Id].SelectedOptionIds"
                                                   value="@option.Id"
                                                   required="@question.IsRequired"
                                                   onchange="removeInvalidClass(this)" />
                                            <label class="form-check-label" for="question-@question.Id-option-@option.Id">
                                                @option.Text
                                            </label>
                                        </div>
                                    }
                                    <div class="invalid-feedback">
                                        You must select exactly one option.
                                    </div>
                                    break;
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <button type="submit" class="btn btn-primary">Submit</button>
    </form>
</div>

@Html.ActionLink("Back to Questionnaire List", "Index", "Questionnaires")

<script>
    function removeInvalidClass(element) {
        // Check if the element is valid
        if (element.checkValidity()) {
            element.classList.remove('is-invalid');
            const feedback = element.closest('.form-group').querySelector('.invalid-feedback');
            if (feedback) {
                feedback.style.display = 'none';  // Hide validation message
            }
        }
    }

    // Bootstrap's custom validation script
    (function () {
        'use strict'
        var forms = document.querySelectorAll('.needs-validation')
        Array.prototype.slice.call(forms)
            .forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    form.classList.add('was-validated')
                }, false)
            })
    })()
</script>
