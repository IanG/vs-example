@using Microsoft.CodeAnalysis.CSharp.Syntax
@using VsExample.Domain.Entities.Questions
@model VSExample.Web.ViewModels.QuestionSets.QuestionSetDetailsViewModel

@functions 
{
    int GetTotalQuestionCount() => Model.QuestionSet.QuestionGroups.Sum(questionGroup => questionGroup.Questions.Count);
    int GetQuestionGroupCount() => Model.QuestionSet.QuestionGroups.Count;
    int GetQuestionsInGroup(int id) => Model.QuestionSet.QuestionGroups.FirstOrDefault(questionGroup => questionGroup.Id == id)?.Questions.Count ?? 0;
}

@{ Dictionary<string, List<string>> dataPoints = Model.DataPoints ?? new Dictionary<string, List<string>>(); }

<div class="container">
    <div id="questionset-@Model.QuestionSet.Id" class="question-set">
        <h1>@Model.QuestionSet.Name</h1>
        <p id="form-description" class="form-label">@Model.QuestionSet.Description. Please complete the following @GetTotalQuestionCount() questions arranged into @GetQuestionGroupCount() groups.</p>

        <form asp-action="Submit" id="form" enctype="multipart/form-data" method="post" class="needs-validation" aria-describedby="form-description" novalidate>
            <input type="hidden" name="__QuestionSetId" value="@Model.QuestionSet.Id"/>
            <input type="hidden" name="__QuestionSetVersion" value="@Model.QuestionSet.Version"/>
            
            @* Output each group *@
            
            @foreach (var group in Model.QuestionSet.QuestionGroups.OrderBy(g => g.Order))
            { 
                <div id="question-group@group-@group.Id" class="question-group">
                    <div class="card mb-4">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1 me-3">
                                <h5 class="mb-0">@group.Name</h5>
                                <small class="text-muted">@group.Description</small>
                                <div class="question-group-progress" style="background-color: white" role="progressbar" aria-label="Example with label" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-bar bg-success" style="width: 0%">0%</div>
                                </div>
                            </div>
                            <div class="question-group-status">0 of 0</div>
                        </div>
                        
                        <div class="card-body">

                            @* Output each question in this group *@
                            
                            @foreach (var question in group.Questions.OrderBy(q => q.Order))
                            {
                                List<string> dataPointValues = dataPoints.GetValueOrDefault(question.CapturesField) ?? new();

                                <div id="question-group-@group.Id-question-@question.Id" class="question"
                                     @(string.IsNullOrEmpty(question.VisibilityRule) 
                                         ? ""
                                         : @Html.Raw($"data-visibility-rule=\"{question.VisibilityRule}\""))
                                     >
                                     
                                    <div class="mb-3">
                                        <label for="question-@question.Id" class="form-label"><strong>@question.Id. @question.Prompt</strong></label>
                                        <div id="question-@question.Id-help" class="form-text">@Html.Raw(question.HelpText)</div>
                                        @switch (question)
                                        {
                                            case StringQuestion stringQuestion:
                                                <input type="text"
                                                       class="form-control"
                                                       id="question-@stringQuestion.Id"
                                                       name="@stringQuestion.CapturesField"
                                                       aria-labelledby="question-@stringQuestion.Id"
                                                       aria-required="@stringQuestion.Required"
                                                       aria-describedby="question-@stringQuestion.Id-help"
                                                       minlength="@stringQuestion.MinLength"
                                                       maxlength="@stringQuestion.MaxLength"
                                                       required="@stringQuestion.Required"
                                                       placeholder="@stringQuestion.Placeholder"
                                                       data-captures-field="@stringQuestion.CapturesField"
                                                       value="@(dataPointValues.FirstOrDefault() ?? "")"
                                                       @* @if (!string.IsNullOrEmpty(stringQuestion.VisbilityRule)) *@
                                                       @* { *@
                                                       @*     @Html.Raw($"data-visibility-rule=\"{stringQuestion.VisbilityRule}\"") *@
                                                       @* }/> *@
                                                />
                                                break;
                                                
                                            case IntegerQuestion integerQuestion:
                                                <input type="number"
                                                       class="form-control"
                                                       id="question-@integerQuestion.Id"
                                                       name="@integerQuestion.CapturesField"
                                                       min="@integerQuestion.MinValue"
                                                       max="@integerQuestion.MaxValue"
                                                       required="@integerQuestion.Required"
                                                       placeholder="@integerQuestion.Placeholder"
                                                       data-captures-field="@integerQuestion.CapturesField"
                                                       value="@(dataPointValues.FirstOrDefault() ?? "")"
                                                       @* @if (!string.IsNullOrEmpty(integerQuestion.VisbilityRule)) *@
                                                       @* { *@
                                                       @*     @($"data-visibility-rule=\"{integerQuestion.VisbilityRule}\"") *@
                                                       @* }/> *@
                                                />
                                                break;

                                            case RatingQuestion ratingQuestion:
                                                @foreach (var option in ratingQuestion.Labels)
                                                {
                                                    <div class="form-check">
                                                        <input type="radio"
                                                               class="form-check-input"
                                                               id="question-@ratingQuestion.Id-option-@option.Key"
                                                               name="@ratingQuestion.CapturesField"
                                                               value="@option.Value"
                                                               aria-description="@option.Key"
                                                               required="@ratingQuestion.Required"
                                                               data-captures-field="@ratingQuestion.CapturesField"
                                                               @if (!string.IsNullOrEmpty(ratingQuestion.VisibilityRule))
                                                               {
                                                                   @($"data-visibility-rule=\"{ratingQuestion.VisibilityRule}\"")
                                                               }/>
                                                        <label class="form-check-label" for="question-@question.Id-option-@option.Value">
                                                            @option.Value
                                                        </label>
                                                    </div>
                                                }

                                                break;
                                                
                                            @* case SingleChoiceQuestion singleChoiceQuestion: *@
                                            @*     <select class="form-select" *@
                                            @*             id="question-@singleChoiceQuestion.Id" *@
                                            @*             name="@singleChoiceQuestion.CapturesField" *@
                                            @*             aria-labelledby="question-@singleChoiceQuestion.Id" *@
                                            @*             aria-describedby="question-@singleChoiceQuestion.Id-help" *@
                                            @*             data-captures-field="@singleChoiceQuestion.CapturesField" *@
                                            @*             required = "@singleChoiceQuestion.Required"> *@
                                            @* *@
                                            @*         <option value="" disabled selected hidden>@singleChoiceQuestion.Placeholder</option> *@
                                            @*         @foreach (var option in singleChoiceQuestion.Options) *@
                                            @*         { *@
                                            @*             <option value="@option.Value">@option.Label</option> *@
                                            @*         } *@
                                            @*     </select> *@
                                            @*     break; *@
                                                         
                                            case SingleChoiceQuestion singleChoiceQuestion:
                                                @switch(singleChoiceQuestion.SelectionMode)
                                                {
                                                    case SingleChoiceSelectionMode.Radio:
                                                        @* Render as radio buttons *@
                                                        @foreach (var option in singleChoiceQuestion.Options)
                                                        {
                                                            <div class="form-check">
                                                                <input type="radio"
                                                                       class="form-check-input"
                                                                       id="question-@singleChoiceQuestion.Id-@option.Value"
                                                                       name="@singleChoiceQuestion.CapturesField"
                                                                       value="@option.Value"
                                                                       aria-labelledby="question-@singleChoiceQuestion.Id"
                                                                       aria-describedby="question-@singleChoiceQuestion.Id-help"
                                                                       data-captures-field="@singleChoiceQuestion.CapturesField"
                                                                       required="@singleChoiceQuestion.Required"
                                                                       @(dataPoints.GetValueOrDefault(singleChoiceQuestion.CapturesField)?.Contains(option.Value) == true ? "checked" : "")>
                                                                <label class="form-check-label" for="question-@singleChoiceQuestion.Id-@option.Value">
                                                                    @option.Label
                                                                </label>
                                                            </div>
                                                        }
                                                        break;

                                                    case SingleChoiceSelectionMode.Dropdown:
                                                        @* Render as a select dropdown *@
                                                        <select class="form-select"
                                                                id="question-@singleChoiceQuestion.Id"
                                                                name="@singleChoiceQuestion.CapturesField"
                                                                aria-labelledby="question-@singleChoiceQuestion.Id"
                                                                aria-describedby="question-@singleChoiceQuestion.Id-help"
                                                                data-captures-field="@singleChoiceQuestion.CapturesField"
                                                                required = "@singleChoiceQuestion.Required"
                                                                >
                                                    
                                                            <option value="" disabled selected hidden>@singleChoiceQuestion.Placeholder</option>
                                                            @foreach (var option in singleChoiceQuestion.Options)
                                                            {
                                                                bool selectedAttribute = dataPointValues.Contains(option.Value);
                                                                
                                                                <option value="@option.Value" selected="@selectedAttribute">
                                                                    @option.Label
                                                                </option>
                                                            }
                                                        </select>
                                                        break;
                                                }

                                                break;
                                                
                                            case MultiChoiceQuestion multiChoiceQuestion:
                                                @foreach (var option in multiChoiceQuestion.Options)
                                                {
                                                    <div class="form-check">
                                                        <input type="checkbox"
                                                               class="form-check-input"
                                                               id="question-option-@option.Id"
                                                               name="@multiChoiceQuestion.CapturesField"
                                                               value="@option.Value"
                                                               aria-description="@option.Label"
                                                               data-captures-field="@multiChoiceQuestion.CapturesField"
                                                               @if (!string.IsNullOrEmpty(multiChoiceQuestion.VisibilityRule))
                                                               {
                                                                   @($"data-visibility-rule=\"{multiChoiceQuestion.VisibilityRule}\"")
                                                               }/>
                                                        <label class="form-check-label" for="question-option-@option.Id">
                                                            @option.Label
                                                        </label>
                                                    </div>
                                                }

                                                break;

                                            case DateQuestion dateQuestion:
                                                <input type="date"
                                                       class="form-control"
                                                       id="question-@dateQuestion.Id"
                                                       name="@dateQuestion.CapturesField"
                                                       required="@dateQuestion.Required"
                                                       data-captures-field="@dateQuestion.CapturesField"
                                                       value="@(dataPointValues.FirstOrDefault() ?? "")"
                                                       @if (!string.IsNullOrEmpty(dateQuestion.VisibilityRule))
                                                       {
                                                           @($"data-visibility-rule=\"{dateQuestion.VisibilityRule}\"")
                                                       }/>
                                                break;

                                            case FileUploadQuestion fileUploadQuestion:
                                                <input type="file"
                                                       class="form-control"
                                                       id="question-@fileUploadQuestion.Id"
                                                       name="@fileUploadQuestion.CapturesField"
                                                       required="@fileUploadQuestion.Required"
                                                       accept="@string.Join(",", fileUploadQuestion.AllowedFileTypes)"
                                                       data-captures-field="@fileUploadQuestion.CapturesField"
                                                       @if (!string.IsNullOrEmpty(fileUploadQuestion.VisibilityRule))
                                                       {
                                                           @($"data-visibility-rule=\"{fileUploadQuestion.VisibilityRule}\"")
                                                       }>
                                                break;

                                            default:
                                                <p>@question.GetType().Name input Not implemented</p>
                                                break;
                                        }
                                        <div class="invalid-feedback">@question.InvalidDataMessage</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <p id="form-submit-instructions">Submitting will send your information for processing.</p>
            <p id="form-reset-instructions">Press the reset button to clear the form and start again.</p>
            <button type="submit"
                    class="btn btn-primary"
                    aria-label="Submit the form"
                    aria-describedby="form-submit-instructions">
                Submit
            </button>
            <button type="reset"
                    class="btn btn-secondary"
                    aria-label="Reset the form"
                    aria-describedby="form-reset-instructions">
                Reset
            </button>
        </form>
    </div>

    <br/>

    @Html.ActionLink("Back to question set List", "Index", "QuestionSets")
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const form = document.getElementById("form");

        // Add an event listener that checks the validity of child inputs.

        form.addEventListener("blur", function (event) {
            if (event.target.matches("input.form-control, select.form-select, input.form-check-input"))
            {
                validateFormElement(event.target);
            }
        }, true);

        /**
         * Validates a form element and applies Bootstrap validation classes
         * @@param {HTMLInputElement | HTMLSelectElement} element - The form element to validate.
         */

        function validateFormElement(element) {
            if (!element) return false;

            /*
            const { id, name, type, dataset } = element;
            const isValid = type === "select-one" ? element.value !== "" : element.checkValidity();

            console.log(`Checking validity of form element '${id}' name '${name}' type '${type}' captures field '${dataset?.capturesField || "N/A"}' isValid ${isValid}`);

            element.classList.toggle("is-valid", isValid);
            element.classList.toggle("is-invalid", !isValid);
            */
            if (!element) return false;

            const { id, name, type, dataset } = element;
            let isValid = element.checkValidity();

            if (type === "select-one") {
                isValid = element.value !== "";
            } else if (type === "radio") {
                // Validate radio button group by checking if any in the group are checked
                const radioGroup = document.querySelectorAll(`input[name="${name}"]`);
                isValid = [...radioGroup].some(radio => radio.checked);

                // Find the closest `.invalid-feedback` div and toggle visibility
                const feedback = element.closest('.mb-3')?.querySelector('.invalid-feedback');
                if (feedback) {
                    feedback.style.display = isValid ? 'none' : 'block';
                }

                // Apply validation styles to all radios in the group
                radioGroup.forEach(radio => {
                    radio.classList.toggle("is-valid", isValid);
                    radio.classList.toggle("is-invalid", !isValid);
                });
            }

            console.log(`Checking validity of form element '${id}' name '${name}' type '${type}' captures field '${dataset?.capturesField || "N/A"}' isValid ${isValid}`);

            element.classList.toggle("is-valid", isValid);
            element.classList.toggle("is-invalid", !isValid);
            
            return isValid;
        }

        /**
         * Resets a form element back to its default state
         * @@param {HTMLInputElement | HTMLSelectElement} element - The form element to validate.
         */

        function resetFormElement(element)
        {
            if (!element) return;

            const { id, name, type, dataset } = element;

            console.log(`Resetting form element '${id}' name '${name}' type '${type}' captures field '${dataset.capturesField}'`);

            if (type === "select-one") {
                element.selectedIndex = -1;
            } else {
                element.value = "";
            }

            element.classList.remove("is-valid", "is-invalid");
        }

        const formInputs = form.querySelectorAll("input.form-control, select.form-select, input.form-check-input");

        formInputs.forEach(input => {

            // When an input loses focus check the state of the question group
            input.addEventListener("blur", function (event) {
                // Find this input's question group
                const questionGroup = input.closest(".question-group");

                // Find all the inputs in the group it belongs to
                const inputs = questionGroup.querySelectorAll(".form-control");

                // Calculate the valid/invalid counts
                const totalCount = inputs.length;
                const validCount = Array.from(inputs).filter(inp => inp.classList.contains("is-valid")).length;

                // Update the n of n status for the group
                const questionGroupStatus = questionGroup.querySelector(".question-group-status");
                if (questionGroupStatus) {
                    questionGroupStatus.innerText = `${validCount} of ${totalCount}`;
                }

                // Update the progress bar for the group
                const progressBarContainer = questionGroup.querySelector(".question-group-progress");
                if (progressBarContainer) {
                    const progressPercentage = (validCount / totalCount) * 100;
                    progressBarContainer.setAttribute("aria-valuenow", progressPercentage.toFixed(0));

                    const innerProgressBar = progressBarContainer.querySelector(".progress-bar");
                    if (innerProgressBar) {
                        innerProgressBar.style.width = `${progressPercentage}%`;
                        innerProgressBar.innerText = `${progressPercentage.toFixed(0)}%`;
                    }
                }

            })
            
            if (form) {
                form.addEventListener("input", checkQuestionVisibility);
                form.addEventListener("change", checkQuestionVisibility);
            }

            // Initial visibility evaluation on page load
            checkQuestionVisibility();
        });

        // Form submission
        form.addEventListener("submit", function (event) {
            const formContext = getFormContext();

            console.log("Data in form", formContext);

            let isFormValid = true;

            // Validate each input
            formInputs.forEach(input => {
                
                if (!validateFormElement(input)) {
                    isFormValid = false;
                }
                
                const formContext = getFormContext();
                updateQuestionVisibility(formContext);
            });

            // Invalid inputs prevent form submission
            if (!isFormValid) {
                event.preventDefault();
                event.stopPropagation();

                // Scroll the first invalid input into view
                const firstInvalidInput = form.querySelector(".is-invalid");
                if (firstInvalidInput) {
                    firstInvalidInput.focus();
                    firstInvalidInput.scrollIntoView({ behavior: "smooth" });
                }
            }
            else
            {
                console.log("Form is valid");
            }
        });

        // Form reset
        form.addEventListener("reset", function () {
            // Re-evaluate visible questions
            checkQuestionVisibility();
            
            formInputs.forEach(element => {
                resetFormElement(element);
            });
        });

        /**
         * Builds the context object from form inputs for rule evaluation
         * @@returns an object populated with all data point values 
         */
        
        function getFormContext()
        {
            const form = document.getElementById("form");

            const formData = new FormData(form);
            // console.log("FormData", formData);

            const formContext = {};

            Array.from(form).forEach((element) => {
               if (element.hasAttribute("data-captures-field")) {
                   const capturedFieldName = element.dataset.capturesField;

                   switch (element.type) {
                       case "checkbox":
                           if (element.checked) {
                               if (!formContext[capturedFieldName]) {
                                   formContext[capturedFieldName] = [];
                               }
                               formContext[capturedFieldName].push(element.value);
                           }
                           break;

                       case "radio":
                           if (element.checked)
                               formContext[capturedFieldName] = element.value;
                           break;

                       case "file":
                           if (element.files && element.files.length > 0)
                               formContext[capturedFieldName] = element.files[0].name;
                           break;

                       case "number":
                           formContext[capturedFieldName] = element.value;
                           // TODO: Probably should be a number with ? Number(element.value) : null;
                           break;

                       default:
                           formContext[capturedFieldName] = element.value;
                           break;
                   }
               }
            });

            // console.log("Context", formContext);
            return formContext;
        }

        // Evaluates a visibility rule from the forms contextual data
        function evaluateVisibilityRule(rule, context) {
            try {
                // Use Function constructor to evaluate the rule in the context
                const evaluator = new Function(
                    ...Object.keys(context),
                    `return ${rule};`
                );
                return evaluator(...Object.values(context));
            } catch (e) {
                console.error("Error evaluating rule:", rule, e);
                return false;
            }
        }

        function updateQuestionVisibility() {

            const formContext = getFormContext();
            
            // Find all questions with a visibility rule
            const questions = document.querySelectorAll("div.question[data-visibility-rule]");

            // Check every question with a rule to see if its visible/hidden
            questions.forEach((question) => {
                const rule = question.dataset.visibilityRule;
                const isVisible = evaluateVisibilityRule(rule, formContext);

                // Update visibility only if it changes
                const currentDisplay = question.style.display;
                if (isVisible && currentDisplay === "none") {
                    question.style.removeProperty("display");
                } else if (!isVisible && currentDisplay !== "none") {
                    question.style.display = "none";
                }
            });
        }
        
        function updateQuestionGroupVisibility()
        {
            // Find all question groups
            const questionGroups = document.querySelectorAll("div.question-group");

            questionGroups.forEach((group) => {
                // Find all child div elements with the class "question" within this group
                const questions = group.querySelectorAll("div.question");

                // Check if all child questions are hidden
                const allHidden = Array.from(questions).every(
                    (question) => question.style.display === "none"
                );

                // If all child questions are hidden, hide the question group
                if (!allHidden) {
                    group.style.removeProperty("display")
                } else {
                    group.style.display = "none";
                }
            });
        }

        function checkQuestionVisibility(event) {
            
            updateQuestionVisibility();
            updateQuestionGroupVisibility();
        }
    });

</script>
