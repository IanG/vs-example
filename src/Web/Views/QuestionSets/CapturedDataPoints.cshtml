@model VSExample.Web.ViewModels.QuestionSets.CapturedDataPointsViewModel

@{
    ViewData["Title"] = "Captured Data points";
}

<h3>Question Set submitted</h3>
<div>
    
    <div class="card mb-3">
        <div class="card-header bg-primary text-white"><strong>Question Set</strong></div>
        @* <div class="card-body"> *@
        <table class="table table-striped table-bordered table-hover card-body mb-0">
            <tr>
                <td style="width: 30%;"><strong>Id</strong></td>
                <td>@Model.QuestionSet.Id</td>
            </tr>
            <tr>
                <td><strong>Version</strong></td>
                <td>@Model.QuestionSet.Version</td>
            </tr>
            <tr>
                <td><strong>Name</strong></td>
                <td>@Model.QuestionSet.Name</td>
            </tr>
            <tr>
                <td><strong>Description</strong></td>
                <td>@Model.QuestionSet.Description</td>
            </tr>
        </table>
        @* </div> *@
    </div>
    
    <div class="card mb-3">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
            <span><i class="bi bi-question-circle"></i>
                Captured Data Points <span class="fw-lighter">(@Model.DataPoints.Count(kvp => !kvp.Key.StartsWith("__")))</span></span>
            <a data-bs-toggle="collapse" href="#dataPointsCardBody" role="button">
                <i class="bi bi-chevron-up text-white" id="dataPointsToggleIcon"></i>
            </a>
        </div>
        <div id="dataPointsCardBody" class="card-body collapse show p-0">
            <table class="table table-striped table-bordered table-hover card-body mb-0 p-0">
                <thead>
                <tr>
                    <th style="width: 30%;">Key</th>
                    <th>Value</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.DataPoints.Where(kvp => !kvp.Key.StartsWith("__")))
                {
                    <tr>
                        <td style="width: 30%;">@item.Key</td>
                        <td style="word-break: break-all; overflow-wrap: break-word;">@string.Join(", ", item.Value)</td>
                    </tr>
                }
                </tbody>
            </table>        
        </div>
    </div>

    @if (Model.Files.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                <span>
                    <i class="bi bi-file-earmark"></i>
                    Captured Files <span class="fw-lighter">(@Model.Files.Count)</span>
                </span>
                <a data-bs-toggle="collapse" href="#filesCardBody" role="button">
                    <i class="bi bi-chevron-up text-white" id="filesToggleIcon"></i>
                </a>
            </div>
            <div id="filesCardBody" class="card-body collapse show p-0">
                <table class="table table-striped table-bordered table-hover card-body mb-0 p-0">
                    <thead>
                    <tr>
                        <th style="width: 30%;">Name</th>
                        <th style="width: 30%;">File Name</th>
                        <th style="width: 20%;">Content Type</th>
                        <th nowrap style="width: 10%;">File Size (bytes)</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Files)
                    {
                        <tr>
                            <td style="width: 30%;">@item.Name</td>
                            <td style="width: 30%;">@item.FileName</td>
                            <td>@item.ContentType</td>
                            <td>@item.FileData.Length.ToString("N0")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>    
    }
    
    <div class="card mb-3">
        <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
            <span>
            Other Data <span class="fw-lighter">(@Model.DataPoints.Count(kvp => kvp.Key.StartsWith("__")))</span>
            </span>
            <a data-bs-toggle="collapse" href="#otherFormDataCardBody" role="button">
                <i class="bi bi-chevron-down text-white" id="otherFormDataToggleIcon"></i>
            </a>
        </div>
        <div id="otherFormDataCardBody" class="card-body collapse p-0">
            <table class="table table-striped table-bordered table-hover mb-0">
                <thead>
                <tr>
                    <th style="width: 30%;">Key</th>
                    <th>Value</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.DataPoints.Where(kvp => kvp.Key.StartsWith("__")))
                {
                    <tr>
                        <td style="width: 30%;">@item.Key</td>
                        <td style="word-break: break-all; overflow-wrap: break-word;">@string.Join(", ", item.Value)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <form asp-controller="QuestionSets" asp-action="Details" method="post">
        <input type="hidden" name="questionSetId" value="@Model.QuestionSet.Id" />

        @foreach (var entry in Model.DataPoints)
        {
            @foreach (var value in entry.Value)
            {
                <input type="hidden" name="dataPoints[@entry.Key]" value="@value" />
            }
        }
        
        <div class="btn-group gap-2">
            <button type="submit" class="btn btn-primary">Re-Edit With Question Set</button>
            <a asp-controller="QuestionSets" asp-action="Index" class="btn btn-secondary">Back to Question Sets</a>
        </div>
    </form>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Handle click on any collapse toggle
        document.querySelectorAll('[data-bs-toggle="collapse"]').forEach(toggle => {
            toggle.addEventListener('click', function (event) {
                // Prevent the default action
                event.preventDefault();

                const targetId = this.getAttribute('href').substring(1); // Get the target ID
                const target = document.getElementById(targetId);

                // Add event listeners for when the collapse is shown or hidden
                target.addEventListener('shown.bs.collapse', function () {
                    // Change the chevron to "up" when expanded
                    const icon = toggle.querySelector('i');
                    icon.classList.remove('bi-chevron-down');
                    icon.classList.add('bi-chevron-up');
                });

                target.addEventListener('hidden.bs.collapse', function () {
                    // Change the chevron to "down" when collapsed
                    const icon = toggle.querySelector('i');
                    icon.classList.remove('bi-chevron-up');
                    icon.classList.add('bi-chevron-down');
                });
            });
        });
    });


</script>
